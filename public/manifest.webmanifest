{
  "name": "Tiny POS",
  "short_name": "Tiny POS",
  "description": "Tiny POS sales, stock, purchasing, reporting and branch operations.",
  "id": "/",
  "start_url": "/dashboard?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f8fafc",
  "theme_color": "#ffffff",
  "categories": ["business", "finance", "productivity"],
  "icons": [
    {
      "src": "/icons/tiny-pos-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/tiny-pos-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/tiny-pos-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New Sale",
      "short_name": "Sale",
      "description": "Open a new Tiny POS sale",
      "url": "/sales?source=shortcut",
      "icons": [
        {
          "src": "/icons/tiny-pos-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "Open the Tiny POS dashboard",
      "url": "/dashboard?source=shortcut",
      "icons": [
        {
          "src": "/icons/tiny-pos-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
